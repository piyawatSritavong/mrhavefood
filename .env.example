# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio)
GEMINI_CHAT_API_KEY=
GEMINI_PROMOTIONS_API_KEY=

# Shared secret for GET/POST /api/promotions/fetch (sent as "Authorization: Bearer <secret>").
# Vercel Cron sends CRON_SECRET automatically when set as a project env var.
CRON_SECRET=

# Prisma (only for npm run db:* scripts)
DATABASE_URL=

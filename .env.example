# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio)
GEMINI_CHAT_API_KEY=
GEMINI_PROMOTIONS_API_KEY=

# Shared secret for GET/POST /api/promotions/fetch (sent as "Authorization: Bearer <secret>").
# Vercel Cron sends CRON_SECRET automatically when set as a project env var.
CRON_SECRET=

# Prisma (only for npm run db:* scripts)
DATABASE_URL=

# ── AI Automation Farm engine ──
# The farm calls POST /api/promotions/fetch with "Authorization: Bearer $CRON_SECRET"
# (stored on the farm side as MRHAVEFOOD_CRON_SECRET).
# Extra affiliate-feed domains allowed as promo sources, comma separated.
AFFILIATE_FEED_DOMAINS=
# Optional: USD per grounded Gemini request once past the free daily quota.
GEMINI_GROUNDING_USD_PER_REQUEST=

# Affiliate links per platform (https only; rendered with rel="sponsored").
AFFILIATE_URL_GRABFOOD=
AFFILIATE_URL_LINEMAN=
AFFILIATE_URL_SHOPEEFOOD=
AFFILIATE_URL_ROBINHOOD=

# Google AdSense (nothing renders until set). Client looks like ca-pub-XXXXXXXXXXXXXXXX.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_PROMO=

# Local only: fixture source + in-memory table instead of Gemini/Supabase (ignored on Vercel production).
PROMOTIONS_TEST_MODE=
